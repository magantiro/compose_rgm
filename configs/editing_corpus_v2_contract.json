  "data_lanes": [
    {
      "id": "observed_local_analogue",
      "purpose": "context-matched local substitutions and size changes between observed endpoints",
      "admissible_evidence_profiles": [
        "observed_pair_compiled_path",
        "inferred_relation_compiled_path"
      ],
      "reserved_evidence_profiles": [
        "observed_pair_observed_actions"
      ]
    },
    {
      "id": "operator_aware_real_endpoint",
      "purpose": "compile observed endpoint pairs with direct Active8 operations before delete-rebuild fallback",
      "admissible_evidence_profiles": [
        "observed_pair_compiled_path",
        "inferred_relation_compiled_path"
      ],
      "reserved_evidence_profiles": [
        "observed_pair_observed_actions"
      ]
    },
    {
      "id": "linker_positional_topology_analogue",
      "purpose": "two-cut linkers, positional isomers, attachment relocation, and topology-changing real-endpoint analogues",
      "admissible_evidence_profiles": [
        "observed_pair_compiled_path",
        "inferred_relation_compiled_path"
      ],
      "reserved_evidence_profiles": []
    },
    {
      "id": "real_endpoint_multistep_path",
      "purpose": "short and medium compiled paths between real endpoints, with provenance-preserving relationship labels",
      "admissible_evidence_profiles": [
        "observed_pair_compiled_path",
        "inferred_relation_compiled_path"
      ],
      "reserved_evidence_profiles": [
        "observed_pair_observed_actions",
        "genuine_observed_series_compiled_path"
      ]
    },
    {
      "id": "reversible_synthetic_walk",
      "purpose": "rare Active8 contexts, mixed-family composition, correction, and inverse coverage under the production executor",
      "admissible_evidence_profiles": [
        "executor_generated_walk"
      ],
      "reserved_evidence_profiles": []
    }
  ],
