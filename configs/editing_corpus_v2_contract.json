  "partition_resolution_contract": {
    "field": "partition_resolution",
    "resolution_fields": [
      "status",
      "assigned_role",
      "source_endpoint_role",
      "target_endpoint_role",
      "split_component_id",
      "split_assignment_manifest_sha256"
    ],
    "statuses": [
      "assigned",
      "cross_partition_rejected",
      "unassigned_rejected"
    ],
    "status_rules": [
      {
        "status": "assigned",
        "assigned_role_policy": "required_partition_role",
        "endpoint_role_policy": "both_equal_assigned_role",
        "split_component_id_policy": "required",
        "admitted_record_policy": "eligible"
      },
      {
        "status": "cross_partition_rejected",
        "assigned_role_policy": "must_be_null",
        "endpoint_role_policy": "both_partition_roles_distinct",
        "split_component_id_policy": "required",
        "admitted_record_policy": "forbidden"
      },
      {
        "status": "unassigned_rejected",
        "assigned_role_policy": "must_be_null",
        "endpoint_role_policy": "at_least_one_null_other_may_be_partition_role",
        "split_component_id_policy": "required",
        "admitted_record_policy": "forbidden"
      }
    ],
    "assigned_role_domain_ref": "split_contract.partition_roles",
    "accepted_record_status": "assigned",
    "rejected_statuses": [
      "cross_partition_rejected",
      "unassigned_rejected"
    ],
    "rejected_attempt_retention": "pre_admission_candidate_audit_ledger"
  },
  "admitted_record_contract": {
    "applies_to": "accepted_post_split_compiled_traces_only",
    "rejected_attempts_live_in": "pre_admission_candidate_audit_ledger",
    "structural_envelope_validation_scope": "structural_envelope_only_no_trace_predicate_recomputation_or_relationship_receipt_resolution",
