{
  "schema": "compose.editing_corpus_contract",
  "schema_version": 2,
  "contract_id": "compose-editing-corpus-v2-prebuild-r2",
  "status": "DESIGN_NOT_TRAINING_AUTHORIZED",
  "scientific_scope": {
    "model": "property-agnostic canonical molecular-successor editing prior",
    "controller_only_inputs": [
      "immutable_source",
      "goal_or_preference",
      "remaining_budget",
      "protected_mapping",
      "path_constraint_state"
    ],
    "separate_lanes": {
      "editing": "fixed-budget embedded canonical-successor jump chain",
      "de_novo": "separate checkpoint and timed CTMC"
    },
    "max_active_atoms": 40,
    "stereochemistry": "out_of_scope",
    "formal_charge_changes": "out_of_scope_charge_preserving_only"
  },
  "operator_basis": {
    "active8": [
      "atom_insert",
      "atom_delete",
      "atom_restate",
      "bond_reorder",
      "bond_reroute",
      "cycle_insert",
      "cycle_attach",
      "ring_system_restate"
    ],
    "disabled": [
      "ring_system_delete",
      "ring_system_grow"
    ],
    "support_expansion_requires_recorded_decision": [
      "multi_neighbor_atom_insert",
      "fragment_replace_macro",
      "ring_template_macro"
    ]
  },
