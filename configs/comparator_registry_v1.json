{
  "schema": "compose.comparator_registry",
  "schema_version": 2,
  "registry_id": "compose-editing-and-control-comparators-v2",
  "supersedes_registry_id": "compose-editing-and-control-comparators-v1",
  "path_compatibility_note": "The legacy-stable filename is retained so existing readers fail on the explicit schema-version boundary rather than silently selecting a different path.",
  "status": "PREIMPLEMENTATION",
  "availability_policy": "This registry declares required prospective comparison arms. PREIMPLEMENTATION does not claim that an arm is implemented, runnable, or scientifically authorized.",
  "global_fairness_rules": [
    "Use identical source molecules, objective implementations, feasibility predicates, and final evaluators.",
    "Count every property-oracle evaluation, including rejected candidates, particles, prescreened candidates, and reranked endpoints.",
    "Report model calls, legal successors scored, wall time, and accelerator class separately from oracle calls.",
    "Use the same random seeds and output sample count when the baseline interface permits it.",
    "Never claim equal support for an external method; report representation and support differences explicitly.",
    "Do not compare published numbers unless the task, oracle, constraints, budget, and selection rule are identical.",
    "Tune on development tasks only and evaluate the sealed final task set once."
  ],
  "claim_comparisons": [
    {
      "claim_id": "learned_state_dependent_transport",
      "experiments": ["E2"],
      "required": [
        {
          "id": "uniform_canonical_successor",
          "comparison_type": "law_only",
          "same_executor": true,
          "same_support": true,
          "same_budget": true
        },
        {
          "id": "state_independent_empirical_family_prior",
          "comparison_type": "law_only",
          "same_executor": true,
          "same_support": true,
          "same_budget": true
        },
        {
          "id": "learned_unguided_prior",
          "comparison_type": "reference_arm",
          "same_executor": true,
          "same_support": true,
          "same_budget": true
        }
      ],
      "primary_metrics": [
        "held_out_canonical_successor_nll",
        "analogue_target_recovery",
        "path_overhead"
      ]
    },
    {
      "claim_id": "operator_enabled_size_and_topology_adaptation",
      "experiments": ["E3", "E4"],
      "required": [
        {
          "id": "full_operator_basis",
          "comparison_type": "reference_arm",
          "experiments": ["E3", "E4"]
        },
        {
          "id": "no_atom_insert",
          "comparison_type": "support_ablation",
          "experiments": ["E3"],
          "allowed_support_differences": ["atom_insert"]
        },
        {
          "id": "no_atom_delete",
          "comparison_type": "support_ablation",
          "experiments": ["E3"],
          "allowed_support_differences": ["atom_delete"]
        },
        {
          "id": "fixed_cardinality",
          "comparison_type": "support_ablation",
          "experiments": ["E3"],
          "allowed_support_differences": ["atom_insert", "atom_delete"]
        },
        {
          "id": "no_cycle_operations",
          "comparison_type": "support_ablation",
          "experiments": ["E4"],
          "allowed_support_differences": ["cycle_insert", "cycle_attach"]
        },
        {
          "id": "no_bond_reroute",
          "comparison_type": "support_ablation",
          "experiments": ["E3", "E4"],
          "allowed_support_differences": ["bond_reroute"]
        }
      ],
      "conditional": [
        {
          "id": "finite_catalog_topology_editor",
          "comparison_type": "support_ablation",
          "experiments": ["E4"],
          "status": "PROSPECTIVE_UNAVAILABLE",
          "run_gate": "Run only if a legitimate finite-catalog topology editor is implemented, runnable on the frozen E4 tasks, and its support and budget differences are declared before outputs are inspected. The disabled ring_system_grow macro is not an eligible substitute."
        }
      ],
      "primary_metrics": [
        "target_success_within_edit_budget",
        "valid_path_rate",
        "path_efficiency"
      ]
    },
    {
      "claim_id": "finite_horizon_control",
      "experiments": ["E5", "E6"],
      "required": [
        {"id": "unguided_prior", "comparison_type": "same_kernel_controller"},
        {"id": "endpoint_reranking", "comparison_type": "same_kernel_controller"},
        {"id": "greedy_one_step", "comparison_type": "same_kernel_controller"},
        {"id": "local_boltzmann", "comparison_type": "same_kernel_controller"},
        {"id": "smc_feynman_kac", "comparison_type": "same_kernel_controller"},
        {"id": "learned_doob_value", "comparison_type": "same_kernel_controller"},
        {"id": "exact_doob", "comparison_type": "enumerable_oracle_only"}
      ],
      "primary_metrics": [
        "terminal_law_total_variation",
        "backward_value_residual",
        "support_violations"
      ]
    },
    {
      "claim_id": "pareto_and_dynamic_lead_optimization",
      "experiments": ["E7"],
      "required_same_base": [
        "unguided_prior",
        "uniform_canonical_successor",
        "endpoint_reranking",
        "greedy_one_step",
        "local_boltzmann",
        "static_scalarization",
        "mog_dfm_style_rank_hypercone",
        "smc_feynman_kac",
        "learned_doob_value",
        "nsga2_over_compose_successors"
      ],
      "conditional_same_base": [
        {
          "id": "moead_over_compose_successors",
          "status": "CONDITIONAL_UNIMPLEMENTED",
          "run_gate": "Run only after a frozen COMPOSE-successor variation interface, matched oracle accounting, and preregistered MOEA/D hyperparameters exist."
        },
        {
          "id": "areuredi_style_annealed_lbmh",
          "status": "CONDITIONAL_UNIMPLEMENTED",
          "run_gate": "Run only after the published annealed locally balanced mechanism is faithfully adapted to the frozen COMPOSE successor kernel and its matched-budget contract is preregistered."
        }
      ],
      "dynamic_arms": [
        "restart_replan",
        "myopic_retargeting",
        "warm_start_multiobjective_search",
        "reusable_transport_dynamic_control"
      ],
      "mechanistic_switch_arms": [
        "continue_from_switch_state",
        "restart_from_original_source",
        "restart_from_switch_state_with_fresh_sampler",
        "static_compromise_objective"
      ],
      "primary_metrics": [
        "normalized_hypervolume",
        "hypervolume_auc_per_oracle_call",
        "dynamic_adaptation_regret",
        "completely_feasible_trajectory_rate"
      ]
    }
  ],
