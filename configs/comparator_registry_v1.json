  "external_adapter_gate": {
    "required_fields": [
      "code_repository_and_commit",
      "environment_lock",
      "checkpoint_identity",
      "input_standardization",
      "source_set_identity",
      "objective_implementation_hashes",
      "constraint_implementation_hashes",
      "oracle_budget_accounting",
      "seed_policy",
      "selection_rule",
      "output_standardization",
      "failure_handling"
