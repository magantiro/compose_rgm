{
  "name": "tree_fcd_transfer_stage2_graft",
  "purpose": "Quality-bearing topology-revision ablation: empirical-size carbon-tree prior, atom-retaining Graft transport, typed coordinated ring rewrites, and factorized discrete Generator Matching over valid connected molecules.",
  "reference_run": {
    "repository": "compose",
    "recipe": "rank_d500k",
    "reported_fcd": 9.96,
    "reference_molecules": 5000,
    "generated_molecules": 1500
  },
  "arguments": {
    "model": "from_scratch",
    "seed": 20260717,
    "max_atoms": 40,
    "train_size": 50000,
    "validation_size": 2000,
    "test_size": 2000,
    "steps": 30000,
    "recovery_every": 2500,
    "batch_size": 64,
    "hidden_dim": 256,
    "message_passing_steps": 6,
    "training_backend": "factorized_marks",
    "data_workers": 16,
    "path_workers": 16,
    "path_checkpoint_interval": 8,
    "path_shard_size": 2048,
    "corpus_workers": 16,
    "use_bf16": true,
    "rate_factorization": "hierarchical",
    "ring_proposals": "typed_catalog",
    "ring_electronic_mode": "factorized_local",
    "max_cycle_templates": 512,
    "max_attach_templates": 512,
    "max_ear_templates": 512,
    "max_ring_system_templates": 4096,
    "source_prior": "carbon_tree",
    "tree_size_prior": "empirical",
    "tree_couplings_per_target": 2,
    "tree_transport": "size_matched_graft",
    "bond_representation": "aromatic",
    "learning_rate": 0.0003,
    "weight_decay": 0.00001,
    "warmup_steps": 500,
    "minimum_learning_rate_fraction": 0.05,
    "evaluation_every": 500,
    "early_stopping_patience": 8,
    "validation_examples": 2048,
    "test_examples": 4096,
    "late_time_fraction": 0.5,
    "operational_horizon": 16.0,
    "progress_stratification_fraction": 0.5,
    "teacher_ordering": "sequential",
    "time_step": 0.1,
    "max_events": 128,
    "rollout_samples": 2000,
    "rollout_workers": 8,
    "fiber_workers": 12,
    "quality_metrics": true,
    "include_fcd": true,
    "quality_reference_limit": 5000,
    "fcd_generated_limit": 2000,
    "fcd_device": "cpu",
    "device": "auto",
    "torch_threads": 1,
    "output": "results/tree_fcd_transfer_stage2_graft.json",
    "checkpoint": "results/tree_fcd_transfer_stage2_graft.pt",
    "rollout_cache": "results/tree_fcd_transfer_stage2_graft.rollouts.pt"
  }
}
