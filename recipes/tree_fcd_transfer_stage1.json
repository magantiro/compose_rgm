{
  "name": "tree_fcd_transfer_stage1",
  "purpose": "First quality-bearing carbon-tree Generator Matching screen using the transferable lessons from rank_d500k without copying its mask-DFM objective.",
  "reference_run": {
    "repository": "compose",
    "recipe": "rank_d500k",
    "reported_fcd": 9.96,
    "reference_molecules": 5000,
    "generated_molecules": 1500
  },
  "arguments": {
    "model": "from_scratch",
    "seed": 20260717,
    "max_atoms": 24,
    "train_size": 8000,
    "validation_size": 1000,
    "test_size": 1000,
    "steps": 8000,
    "recovery_every": 2000,
    "batch_size": 32,
    "hidden_dim": 128,
    "message_passing_steps": 4,
    "training_backend": "factorized_marks",
    "data_workers": 16,
    "path_workers": 16,
    "corpus_workers": 16,
    "use_bf16": true,
    "rate_factorization": "hierarchical",
    "ring_proposals": "typed_catalog",
    "ring_electronic_mode": "factorized_local",
    "max_cycle_templates": 256,
    "max_attach_templates": 256,
    "max_ear_templates": 256,
    "max_ring_system_templates": 4096,
    "source_prior": "carbon_tree",
    "tree_size_prior": "empirical",
    "tree_couplings_per_target": 4,
    "bond_representation": "aromatic",
    "learning_rate": 0.0005,
    "weight_decay": 0.00001,
    "validation_examples": 1024,
    "test_examples": 2048,
    "late_time_fraction": 0.5,
    "operational_horizon": 12.0,
    "progress_stratification_fraction": 0.5,
    "teacher_ordering": "sequential",
    "time_step": 0.1,
    "max_events": 64,
    "rollout_samples": 2000,
    "rollout_workers": 8,
    "fiber_workers": 12,
    "quality_metrics": true,
    "include_fcd": true,
    "quality_reference_limit": 5000,
    "fcd_generated_limit": 0,
    "fcd_device": "cpu",
    "device": "auto",
    "torch_threads": 1,
    "output": "results/tree_fcd_transfer_stage1.json",
    "checkpoint": "results/tree_fcd_transfer_stage1.pt",
    "rollout_cache": "results/tree_fcd_transfer_stage1.rollouts.pt"
  }
}
