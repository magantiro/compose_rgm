\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{compose_arxiv}[2026/07/30 COMPOSE arXiv manuscript style]

\ifdefined\pdfinfoomitdate
  \pdfinfoomitdate=1
\fi
\ifdefined\pdftrailerid
  \pdftrailerid{}
\fi
\ifdefined\pdfsuppressptexinfo
  \pdfsuppressptexinfo=15
\fi

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lmodern}
\RequirePackage{microtype}
\RequirePackage[
  letterpaper,
  left=0.85in,
  right=0.85in,
  top=0.82in,
  bottom=0.68in,
  footskip=0.34in
]{geometry}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{mathtools}
\RequirePackage{xspace}
\RequirePackage{xcolor}
\RequirePackage{enumitem}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{flafter}
\RequirePackage{natbib}
\RequirePackage{fancyhdr}
\RequirePackage{tikz}
\RequirePackage{hyperref}

\definecolor{composepanel}{HTML}{F1F3F5}
\definecolor{composetext}{HTML}{20242A}
\definecolor{composelink}{HTML}{2468C4}
\definecolor{composepending}{HTML}{A23B2A}

\hypersetup{
  colorlinks=true,
  citecolor=composelink,
  linkcolor=composelink,
  urlcolor=composelink,
  breaklinks=true
}

\color{composetext}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.43em plus 0.08em minus 0.04em}
\setlength{\emergencystretch}{1.2em}
\setlength{\mathsurround}{0pt}
\clubpenalty=10000
\widowpenalty=10000
\displaywidowpenalty=10000
\raggedbottom

\fancyhf{}
\fancyfoot[C]{\normalfont\small\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\pagestyle{fancy}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[C]{\normalfont\small\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

\makeatletter
\renewcommand{\section}{%
  \@startsection{section}{1}{0pt}%
    {1.00em plus 0.12em minus 0.08em}%
    {0.43em plus 0.05em}%
    {\sffamily\bfseries\fontsize{17}{20}\selectfont}%
}
\renewcommand{\paragraph}{%
  \@startsection{paragraph}{4}{0pt}%
    {0.52em plus 0.06em minus 0.04em}%
    {-0.42em}%
    {\sffamily\bfseries\normalsize}%
}
\makeatother

\setlist[enumerate]{
  leftmargin=1.45em,
  labelsep=0.62em,
  topsep=0.35em,
  itemsep=0.32em,
  parsep=0pt,
  partopsep=0pt
}

\newsavebox{\composefrontbox}
\newenvironment{composefrontmatter}{%
  \begin{lrbox}{\composefrontbox}%
  \begin{minipage}{\dimexpr\textwidth-46pt\relax}%
}{%
  \end{minipage}%
  \end{lrbox}%
  \noindent
  \begin{tikzpicture}
    \node[
      fill=composepanel,
      rounded corners=12pt,
      inner xsep=23pt,
      inner ysep=17pt,
      outer sep=0pt
    ] {\usebox{\composefrontbox}};
  \end{tikzpicture}%
  \par\vspace{10pt}%
}

\newcommand{\composetitle}[1]{%
  {\sffamily\bfseries\fontsize{19}{22}\selectfont
   \hyphenpenalty=10000\exhyphenpenalty=10000\raggedright #1\par}%
}
\newcommand{\composeauthors}[1]{%
  \vspace{8pt}%
  {\sffamily\bfseries\fontsize{10.5}{13}\selectfont #1\par}%
}
\newcommand{\composeabstract}[1]{%
  \vspace{15pt}%
  {\sffamily\fontsize{9.2}{11.4}\selectfont #1\par}%
}

\newcommand{\resultpending}[1]{%
  % Keep the stable result key in the TeX source while rendering the compact
  % token requested for the paper-shaped draft.  The Makefile inventories the
  % source key and therefore does not depend on a long, unbreakable PDF label.
  \textcolor{composepending}{\sffamily\bfseries XXX}%
}

\newcommand{\composefigureplaceholder}[2][1.45in]{%
  \begin{center}%
  \colorbox{composepanel}{%
    \begin{minipage}[c][#1][c]{\dimexpr\linewidth-22pt\relax}%
      \centering
      {\sffamily\bfseries\color{composepending} XXX FIGURE\par}%
      \vspace{4pt}%
      {\sffamily\small #2\par}%
    \end{minipage}%
  }%
  \end{center}%
}

\renewcommand{\refname}{References}
\renewcommand{\bibsection}{%
  \section*{\refname}%
}
\setlength{\bibsep}{0.38em}
\bibpunct{(}{)}{;}{a}{,}{,}
