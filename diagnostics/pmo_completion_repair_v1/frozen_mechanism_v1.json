 "what_it_is": {
  "content": "an objective-blind component drawn from the committed bank, installed by a breadth-first spanning tree of atom_insert plus one cycle_close per non-tree edge, with hydrogen reserved at insertion so every intermediate is executable",
  "declared_refusals": "a valence-six centre reached through a single bond cannot reserve five hydrogens (MAX_H_COUNT is 4) and is refused offline; charged components are excluded so net formal charge is preserved",
  "excision": "the same octave-balanced law over the state's bridge-separated regions, uniform WITHIN a size band so region selection stays v1's; a re-ranking with a positive floor, never a filter",
  "scale": "octave-balanced size draw over 1..capacity, capacity = 40 - heavy atoms; equal probability per octave band, uniform within a band; no tuned parameter and no task input",
  "scope_it_governs": "segment_grow and both halves of segment_replace; every other generic family is v1 verbatim"
 }
