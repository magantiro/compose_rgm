{
 "chosen": {
  "because": [
   "Every realization the matched comparison found needed 51-55 expanded nodes, so a node budget below ~55 discards the whole measured benefit while still paying most of the cost.",
   "A 12 s cap loses 3 of the 6 measured realizations; a 20 s cap keeps 6 of 6.",
   "Every success finishes within 16.92 s uncapped while the unproductive searches run 18-64 s, so the cut separates the two distributions.",
   "28 of 48 attempts are refused by constraint propagation in under a second, which is why the mean is 6.88 s and not near the cap."
  ],
  "max_realizations": 4,
  "node_budget": 64,
  "seconds_cap": 20.0
 },
